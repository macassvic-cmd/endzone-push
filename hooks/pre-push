#!/bin/sh
# Pre-push gate: compile every tracked .py with Python 3.11 (CI's version) and run the test suites under it; refuse the push on failure.
# Enable once per clone:  git config core.hooksPath hooks
# Install 3.11 if missing: winget install -e --id Python.Python.3.11 ; py -3.11 -m pip install -r requirements.txt pytest pyyaml
cd "$(git rev-parse --show-toplevel)" || exit 1
if command -v py >/dev/null 2>&1; then PY="py -3.11"; elif command -v python3.11 >/dev/null 2>&1; then PY="python3.11"; else
  echo "pre-push: Python 3.11 not found (CI runs 3.11). Install it: winget install -e --id Python.Python.3.11 ; then py -3.11 -m pip install -r requirements.txt pytest pyyaml"; exit 1; fi
$PY prepush_check.py || { echo "pre-push: check failed under Python 3.11, push refused (fix it, or inspect with: $PY prepush_check.py)"; exit 1; }
